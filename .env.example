# Copy this file to .env and fill in your own key. Never commit .env.
#
# We use OpenRouter (https://openrouter.ai) as a single OpenAI-compatible
# gateway to multiple LLM providers, so the OpenAI python SDK works unmodified
# by pointing base_url at OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# Model used for intent classification / structured extraction (cheap, fast).
OPENROUTER_CLASSIFIER_MODEL=openai/gpt-4o-mini

# Model used for grounded reply generation.
OPENROUTER_GENERATION_MODEL=openai/gpt-4o-mini

# Model used as the LLM judge for reply quality (kept distinct from the
# generation model to reduce self-preference bias).
OPENROUTER_JUDGE_MODEL=anthropic/claude-3.5-sonnet

# No credits on your OpenRouter account? Free-tier models work with this
# same code (see docs/decision_log.md #15 for what was actually used and
# why, including one free model that was tried and consistently
# rate-limited): e.g.
#   OPENROUTER_CLASSIFIER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   OPENROUTER_GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   OPENROUTER_JUDGE_MODEL=dots-studio/dots-3-note-preview:free
# Check https://openrouter.ai/models?max_price=0 for the current list -
# free-model availability and rate limits change over time.

# Base URL for the OpenRouter OpenAI-compatible API. Override only for testing.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
